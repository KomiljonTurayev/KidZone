<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Asosiy tema -->
    <style name="Theme.KidZone" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF6B35</item>
        <item name="colorPrimaryVariant">#E55A25</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF9F1C</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#FF6B35</item>
        <item name="android:navigationBarColor">#080818</item>
        <item name="android:windowBackground">#FF6B35</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Splash screen -->
    <style name="Theme.KidZone.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF6B35</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.KidZone</item>
    </style>

    <!-- Professional Bejirim Dialog -->
    <style name="Theme.KidZone.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.KidZone.Dialog</item>
        <item name="colorPrimary">#FF6B35</item>
    </style>

    <style name="ShapeAppearance.KidZone.Dialog" parent="">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Bottom Sheet dialog — transparent background so custom shape shows -->
    <style name="Theme.KidZone.BottomSheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.KidZone.BottomSheet</item>
    </style>

    <style name="Widget.KidZone.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

</resources>
