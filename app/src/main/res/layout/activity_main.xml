<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080818">

    <!-- WebView — o'yinlar shu yerda -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#080818"/>

    <!-- AI Bird Character - Placed above the Bottom Navigation to be accessible -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnBirdAi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:src="@android:drawable/ic_menu_help"
        app:backgroundTint="#FF6B35"
        app:layout_constraintBottom_toTopOf="@id/bannerContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/ai_bird_name"
        app:elevation="12dp"
        app:rippleColor="#FFFFFF"/>

    <!-- AdMob Banner — pastda -->
    <LinearLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center_horizontal"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
