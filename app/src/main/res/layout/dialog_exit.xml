<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_exit_sheet"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <!-- Gradient Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:background="@drawable/bg_dialog_header"
        android:clipChildren="true">

        <!-- Decorative circle — top left -->
        <View
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-35dp"
            android:layout_marginTop="-35dp"
            android:alpha="0.15"
            android:background="@drawable/shape_circle_light"/>

        <!-- Decorative circle — bottom right -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-25dp"
            android:layout_marginBottom="-25dp"
            android:alpha="0.12"
            android:background="@drawable/shape_circle_light"/>

        <!-- Decorative circle — top right small -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="20dp"
            android:alpha="0.2"
            android:background="@drawable/shape_circle_light"/>

        <!-- Decorative circle — bottom left small -->
        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="20dp"
            android:alpha="0.18"
            android:background="@drawable/shape_circle_light"/>

        <!-- Main emoji -->
        <TextView
            android:id="@+id/dialog_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="👋"
            android:textSize="76sp"/>

    </FrameLayout>

    <!-- White content area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KidZone'dan chiqish?"
            android:textColor="#1A1A2E"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Haqiqatan ham chiqib ketmoqchimisiz? Sizni sog'inib qolamiz!"
            android:textColor="#78788C"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="28dp"/>

        <!-- Yes — filled orange -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_yes"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ha, chiqish"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="16dp"
            app:backgroundTint="#FF6B35"
            app:rippleColor="#20000000"
            android:layout_marginBottom="10dp"/>

        <!-- No — outlined -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_no"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Yo'q, qolish"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF6B35"
            app:cornerRadius="16dp"
            app:strokeColor="#FF6B35"
            app:strokeWidth="2dp"/>

    </LinearLayout>

</LinearLayout>
