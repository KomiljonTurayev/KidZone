<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/auth_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/cloud_signin_title"
        android:textSize="18sp" android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/cloud_email_hint"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/auth_email"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/cloud_password_hint"
        android:layout_marginBottom="8dp"
        app:passwordToggleEnabled="true">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/auth_password"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/auth_error"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E53935" android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/auth_submit"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="@string/cloud_signin_title"
        android:backgroundTint="#FF6B35"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/auth_toggle_mode"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/cloud_toggle_to_create"
        android:textColor="#FF6B35"/>

</LinearLayout>
