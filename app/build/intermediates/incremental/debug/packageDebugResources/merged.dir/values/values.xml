<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#000000</color>
    <color name="ic_launcher_background">#FF6B35</color>
    <color name="primary">#FF6B35</color>
    <color name="primary_dark">#E55A25</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">KidZone</string>
    <string name="banner_ad_unit_id">ca-app-pub-_____________________________/_______________</string>
    <string name="interstitial_ad_unit_id">ca-app-pub-_____________________________/_______________</string>
    <string name="rewarded_ad_unit_id">ca-app-pub-_____________________________/_______________</string>
    <style name="Theme.KidZone" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF6B35</item>
        <item name="colorPrimaryVariant">#E55A25</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF9F1C</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#FF6B35</item>
