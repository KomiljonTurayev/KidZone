rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "admin@kidzone.uz"
      );
    }

    // User document and all child subcollections (profiles, daily_challenges, stats)
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Public / authenticated config like banners
    match /config/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Banners and Categories collections
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily aggregate stats recorded by client sessions
    match /stats/{dateKey} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Streak reminder runs logs
    match /streak_reminder_runs/{runId} {
      allow read, write: if isAdmin();
    }
  }
}

