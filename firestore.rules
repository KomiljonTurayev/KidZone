rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == "admin@kidzone.uz" && request.auth.token.email_verified == true)
      );
    }

    // Client writes to profiles/{id} come from two independent merge() calls
    // (ProfileSyncManager.pushProfile and FirestoreSync.syncStreak), so the
    // allowed key set is their union and every field is optional per write —
    // but any field that IS present must have a sane type/range. This stops a
    // scripted client (bypassing the app's PIN-gated UI) from writing garbage
    // or unexpected fields into a profile it legitimately owns.
    function isValidProfileWrite(data) {
      return data.keys().hasOnly(['name', 'language', 'timeLimitMinutes', 'pinHash', 'isDefault', 'createdAt', 'streak']) &&
        (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
        (!('language' in data) || data.language in ['uz', 'ru', 'en']) &&
        (!('timeLimitMinutes' in data) || (data.timeLimitMinutes is int && data.timeLimitMinutes >= 0 && data.timeLimitMinutes <= 1440)) &&
        (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() <= 64)) &&
        (!('isDefault' in data) || data.isDefault is bool) &&
        (!('createdAt' in data) || data.createdAt is int) &&
        (!('streak' in data) || isValidStreak(data.streak));
    }

    function isValidStreak(streak) {
      return streak is map &&
        streak.keys().hasOnly(['count', 'lastCompletedDate']) &&
        (!('count' in streak) || (streak.count is int && streak.count >= 0)) &&
        (!('lastCompletedDate' in streak) || streak.lastCompletedDate is string);
    }

    function isValidChallengeWrite(data) {
      return data.keys().hasOnly(['gameId', 'gameTitle', 'completed', 'completedAt']) &&
        (!('gameId' in data) || (data.gameId is string && data.gameId.size() > 0)) &&
        (!('gameTitle' in data) || data.gameTitle is string) &&
        (!('completed' in data) || data.completed is bool) &&
        (!('completedAt' in data) || data.completedAt is timestamp);
    }

    function isValidProfileStatsWrite(data) {
      return data.keys().hasOnly(['minutesPlayed', 'gamesPlayed']) &&
        (!('minutesPlayed' in data) || (data.minutesPlayed is int && data.minutesPlayed >= 0 && data.minutesPlayed <= 1440)) &&
        (!('gamesPlayed' in data) || (data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000));
    }

    // User document and all child subcollections (profiles, daily_challenges, stats)
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Owner can initialize their profile with status=active or no status; cannot forge other statuses
      allow create: if (isOwner(uid) && (!('status' in request.resource.data) || request.resource.data.status == 'active')) || isAdmin();
      // Owner cannot alter status field once set (cannot unban themselves); only admin can change status
      allow update: if (isOwner(uid) && (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)) || isAdmin();
      allow delete: if isAdmin();

      match /profiles/{profileId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && isValidProfileWrite(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();

        // Server-authoritative daily play-time counters (written only by the backend via
        // the Firebase Admin SDK, which bypasses these rules). The client must never write
        // its own elapsedSeconds — that would defeat the point of moving the limit off-device.
        match /playtime/{date} {
          allow read: if isOwner(uid) || isAdmin();
          allow write: if isAdmin();
        }

        // Parent sync data written by the client (daily-challenge completion, stats charts).
        // Named explicitly rather than via a recursive {name=**} wildcard: Firestore unions
        // permissions across every match block whose pattern matches a path, so a catch-all
        // here would also match /users/{uid} and /profiles/{profileId}/playtime/{date}
        // themselves — silently overriding their admin-only delete/write restrictions with
        // owner access (this exact bug let an owner self-unban and forge their own playtime
        // counter; caught by firestore-tests/firestore.rules.test.js).
        match /daily_challenges/{date} {
          allow read: if isOwner(uid) || isAdmin();
          allow create, update: if (isOwner(uid) && isValidChallengeWrite(request.resource.data)) || isAdmin();
          allow delete: if isOwner(uid) || isAdmin();
        }

        match /stats/{date} {
          allow read: if isOwner(uid) || isAdmin();
          allow create, update: if (isOwner(uid) && isValidProfileStatsWrite(request.resource.data)) || isAdmin();
          allow delete: if isOwner(uid) || isAdmin();
        }
      }
    }

    // Public / authenticated config like banners
    match /config/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Banners and Categories collections
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily aggregate stats recorded by client sessions
    match /stats/{dateKey} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['dau', 'totalMinutes', 'totalSessions', 'gameBreakdown']) &&
        dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if isAdmin();
    }

    // Streak reminder runs logs
    match /streak_reminder_runs/{runId} {
      allow read, write: if isAdmin();
    }
  }
}

