rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid
                         || request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_UID";
    }
    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_UID";
    }
  }
}
